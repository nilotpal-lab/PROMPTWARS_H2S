# VayuMitra environment configuration
# Copy to .env for local development (never commit .env)

# GenAI narration & copilot (falls back cleanly to deterministic mode if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local HTTP server port
PORT=3000

# Optional air quality & fire telemetry upgrades (Tier 0 Open-Meteo requires no keys)
WAQI_API_KEY=
DATA_GOV_IN_API_KEY=
NASA_FIRMS_MAP_KEY=

# Optional Upstash Redis REST cache & rate limiter (falls back to in-memory LRU if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
