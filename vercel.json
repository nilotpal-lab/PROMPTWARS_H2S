{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "engine.js,flight_network.json"
    }
  },
  "rewrites": [
    {
      "source": "/engine.js",
      "destination": "/api/index.js"
    },
    {
      "source": "/flight_network.json",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
